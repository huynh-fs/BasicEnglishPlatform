@model IEnumerable<BasicEnglishPlatform.Data.Entities.Enrollment>

@{
    ViewData["Title"] = "Khóa học của tôi";
}

<div class="container mt-4">
    <h2>🎓 Khóa học của tôi</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="lead text-muted">Bạn chưa đăng ký khóa học nào.</p>
            <a asp-controller="Course" asp-action="Index" class="btn btn-primary">Tìm khóa học ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Course.Title</h5>
                            <p class="card-text text-muted small">
                                Đăng ký ngày: @item.RegisteredAt.ToString("dd/MM/yyyy")
                            </p>

                            <div class="alert alert-light border">
                                <strong>📅 Lịch học:</strong>
                                <ul class="mb-0 ps-3">
                                    @foreach (var sch in item.Course.Schedules)
                                    {
                                        <li>
                                            @sch.DayOfWeek.ToVietnamese()
                                            (@sch.StartTime.ToString(@"hh\:mm") - @sch.EndTime.ToString(@"hh\:mm"))
                                            - Phòng: @sch.Room
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                Điểm số:
                                @(item.Grade.HasValue? item.Grade.Value.ToString() : "Chưa có")
                            </span>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-secondary">Xem lại</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>