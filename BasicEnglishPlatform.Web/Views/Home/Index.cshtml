@model IEnumerable<BasicEnglishPlatform.Data.Entities.Course>

@{
    ViewData["Title"] = "Nền tảng học Tiếng Anh 4.0";
}

<!-- 1. HERO SECTION: Banner chính -->
<div class="hero-section text-white d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Học Tiếng Anh Chủ Động Với Trợ Lý AI</h1>
                <p class="lead mb-4">Nâng trình tiếng Anh của bạn với các khóa học chất lượng, lịch học linh hoạt và sự hỗ trợ 24/7 từ Gemini AI.</p>
                <div class="d-flex gap-3">
                    <a href="#courses-list" class="btn btn-light btn-lg text-primary fw-bold px-4">Khám phá ngay</a>
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">Đăng ký miễn phí</a>
                    }
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block text-center">
                <!-- Ảnh minh họa (Vector hoặc 3D) -->
                <img src="https://cdn-icons-png.flaticon.com/512/4844/4844439.png" alt="Learning" class="img-fluid hero-img" style="max-height: 400px;">
            </div>
        </div>
    </div>
</div>

<!-- 2. STATS SECTION: Thống kê -->
<div class="bg-light py-4 border-bottom">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4">
                <h3 class="fw-bold text-primary">1,000+</h3>
                <p class="text-muted">Học viên tin tưởng</p>
            </div>
            <div class="col-md-4">
                <h3 class="fw-bold text-primary">50+</h3>
                <p class="text-muted">Khóa học chất lượng</p>
            </div>
            <div class="col-md-4">
                <h3 class="fw-bold text-primary">24/7</h3>
                <p class="text-muted">Hỗ trợ bởi AI</p>
            </div>
        </div>
    </div>
</div>

<!-- 3. FEATURED COURSES: Khóa học nổi bật -->
<div id="courses-list" class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold">Khóa học nổi bật</h2>
            <p class="text-muted mb-0">Các khóa học được đăng ký nhiều nhất tuần qua</p>
        </div>
        <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary">Xem tất cả</a>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 course-card border-0 shadow-sm">
                        <!-- Ảnh bìa có link -->
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@item.Id" class="overflow-hidden position-relative">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/400x250?text=English+Course" : item.ImageUrl)"
                                 class="card-img-top course-img" alt="@item.Title">
                            @if (item.Price == 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-2">Miễn phí</span>
                            }
                        </a>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark stretched-link">
                                    @item.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.Description != null && item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                            </p>

                            <!-- Rating giả lập cho đẹp -->
                            <div class="mb-2 text-warning small">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>
                                <span class="text-muted ms-1">(4.8)</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <span class="small text-muted">@item.Schedules.Count buổi/tuần</span>
                                </div>
                                <span class="fw-bold fs-5 text-primary">
                                    @(item.Price == 0 ? "Free" : item.Price.ToString("#,##0") + "đ")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="mb-3 opacity-50" />
                <p class="text-muted">Chưa có khóa học nào được đăng tải.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Course" asp-action="Create" class="btn btn-primary">Tạo khóa học ngay</a>
                }
            </div>
        }
    </div>
</div>

<!-- 4. WHY CHOOSE US: Tính năng -->
<div class="bg-white py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Tại sao chọn nền tảng này?</h2>
            <p class="text-muted">Chúng tôi mang đến trải nghiệm học tập khác biệt</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="feature-icon bg-primary bg-opacity-10 text-primary mb-3 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-robot fs-1">🤖</i>
                </div>
                <h4>Trợ lý AI Thông minh</h4>
                <p class="text-muted">Tích hợp Gemini AI giúp giải đáp thắc mắc ngữ pháp, từ vựng ngay lập tức.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon bg-success bg-opacity-10 text-success mb-3 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-calendar-check fs-1">📅</i>
                </div>
                <h4>Lịch học Linh hoạt</h4>
                <p class="text-muted">Hệ thống tự động kiểm tra trùng lịch, giúp bạn sắp xếp thời gian học tối ưu.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon bg-warning bg-opacity-10 text-warning mb-3 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-laptop fs-1">💻</i>
                </div>
                <h4>Học mọi lúc mọi nơi</h4>
                <p class="text-muted">Truy cập bài giảng và tài liệu học tập từ bất kỳ thiết bị nào có kết nối Internet.</p>
            </div>
        </div>
    </div>
</div>

<!-- 5. CTA: Kêu gọi hành động -->
<div class="bg-primary text-white py-5 text-center">
    <div class="container">
        <h2 class="fw-bold mb-3">Sẵn sàng bắt đầu hành trình chinh phục Tiếng Anh?</h2>
        <p class="lead mb-4">Đăng ký ngay hôm nay để nhận lộ trình học tập cá nhân hóa.</p>
        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg fw-bold px-5 rounded-pill shadow">Đăng ký ngay</a>
        }
        else
        {
            <a asp-controller="Course" asp-action="Index" class="btn btn-light btn-lg fw-bold px-5 rounded-pill shadow">Xem khóa học</a>
        }
    </div>
</div>

<!-- CSS Tùy chỉnh cho trang Home -->
<style>
    /* Hero Section Gradient */
    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        padding: 100px 0;
        margin-top: -20px; /* Kéo lên đè padding của container layout */
    }

    /* Hiệu ứng ảnh Hero */
    .hero-img {
        animation: float 3s ease-in-out infinite;
    }

    /* Card khóa học */
    .course-card {
        transition: transform 0.3s, box-shadow 0.3s;
    }
    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .course-img {
        height: 200px;
        object-fit: cover;
        transition: transform 0.5s;
    }
    .course-card:hover .course-img {
        transform: scale(1.05);
    }
</style>