@model IEnumerable<BasicEnglishPlatform.Data.Entities.Course>

@{
    ViewData["Title"] = "Quản lý Khóa học";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary"><i class="bi bi-gear-fill"></i> Quản lý Khóa học</h2>
            <p class="text-muted">Danh sách tất cả các khóa học trong hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Tạo khóa học mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-2">Khóa học</th>
                        <th>Học phí</th>
                        <th>Lịch học</th>
                        <th>Sĩ số</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-2">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/50" : item.ImageUrl)"
                                         class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold">@item.Title</div>
                                        <div class="small text-muted">ID: @item.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @(item.Price == 0 ? "Miễn phí" : item.Price.ToString("#,##0") + " đ")
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Schedules.Count buổi/tuần</span>
                            </td>
                            <td>
                                @{
                                    int currentCount = item.Enrollments?.Count ?? 0;
                                    int max = item.MaxCapacity;
                                    // Tính phần trăm để làm thanh tiến trình (Optional - cho đẹp)
                                    int percent = max > 0 ? (currentCount * 100 / max) : 0;
                                }

                                <div class="d-flex align-items-center">
                                    <span class="me-2">@currentCount / @max</span>
                                    <div class="progress flex-grow-1" style="height: 5px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @percent%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.IsPublished)
                                {
                                    <span class="badge bg-success">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ẩn (Nháp)</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Grading" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Nhập điểm">
                                    <i class="bi bi-pencil-square">Nhập điểm</i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="bi bi-eye">Xem</i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil">Sửa</i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @if (item.IsPublished)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn khóa học này"
                                                onclick="return confirm('Bạn muốn ẩn khóa học này khỏi trang chủ?');">
                                            <i class="bi bi-eye-slash">Ẩn</i> <!-- Icon mắt gạch chéo -->
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Công khai khóa học này"
                                                onclick="return confirm('Bạn muốn hiển thị khóa học này lên trang chủ?');">
                                            <i class="bi bi-eye">Hiện</i> <!-- Icon mắt mở -->
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>